  "fixed_sql": [
    {
      "name": "shopping_lists",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"shopping_lists\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"currency_code\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (length(name) >= 1 AND length(name) <= 60), CHECK (currency_code IN ('NGN', 'GHS', 'KES', 'ZAR', 'USD', 'GBP', 'EUR')));"
        }
      ]
    },
    {
      "name": "shopping_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"shopping_items\" (\"id\" TEXT NOT NULL, \"list_id\" TEXT NOT NULL REFERENCES shopping_lists (id) ON DELETE CASCADE, \"name\" TEXT NOT NULL, \"quantity_milli\" INTEGER NOT NULL, \"unit\" TEXT NULL, \"unit_price_minor\" INTEGER NOT NULL, \"is_bought\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_bought\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (length(name) >= 1 AND length(name) <= 80), CHECK (quantity_milli >= 1 AND quantity_milli <= 9999999), CHECK (unit IS NULL OR (length(unit) >= 1 AND length(unit) <= 20)), CHECK (unit_price_minor >= 0 AND unit_price_minor <= 9999999999));"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"id\" INTEGER NOT NULL, \"default_currency_code\" TEXT NOT NULL, \"theme_mode\" TEXT NOT NULL DEFAULT 'system', \"onboarding_done\" INTEGER NOT NULL DEFAULT 0 CHECK (\"onboarding_done\" IN (0, 1)), PRIMARY KEY (\"id\"), CHECK (id = 1), CHECK (default_currency_code IN ('NGN', 'GHS', 'KES', 'ZAR', 'USD', 'GBP', 'EUR')), CHECK (theme_mode IN ('system', 'light', 'dark')));"
        }
      ]
    },
    {
      "name": "idx_items_list_created",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX idx_items_list_created ON shopping_items (list_id, created_at)"
        }
      ]
    }
